{
  "name": "water-analysis-backend",
  "version": "1.0.0",
  "description": "High-performance Water Situation Backend powered by Bun, Hono, Drizzle ORM, and Cloudflare R2",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "sync": "bun src/scripts/syncTelemetry.ts",
    "sync:all": "bun src/scripts/syncTelemetry.ts --full",
    "sync:telemetry": "bun src/scripts/syncTelemetry.ts",
    "sync:bulletin": "bun src/scripts/syncBulletin.ts",
    "llm:sync": "bun src/scripts/syncBulletin.ts",
    "scraper": "bun src/scripts/syncTelemetry.ts",
    "clean:chao": "bun src/scripts/cleanChaoPhraya.ts",
    "import:stations": "bun src/scripts/importResolvedStations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts",
    "upload:boundary": "bun src/scripts/uploadBasinBoundaries.ts",
    "sync:boundary": "bun src/scripts/uploadBasinBoundaries.ts",
    "upload:flowpaths": "bun src/scripts/uploadFlowPaths.ts",
    "sync:flowpaths": "bun src/scripts/uploadFlowPaths.ts",
    "upload:basin": "bun src/scripts/publishBasinMeta.ts",
    "sync:basin": "bun src/scripts/publishBasinMeta.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "openai": "^7.5.0",
    "postgres": "^3.4.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3"
  }
}
