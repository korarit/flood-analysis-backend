# App Configuration
PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/water_analysis

# External Cronjob Security
CRON_SECRET=water_analysis_cron_secret_key_2026

# ThaiWater Platform API Configuration (from api-soucre.md)
THAIWATER_API_BASE_URL=https://twa-api-public.thaiwater.net
THAIWATER_API_KEY=TPSXrHRvTHeVT2Lygq6YeTqqAm4xZ72x
THAIWATER_ORIGIN=https://twa.thaiwater.net
THAIWATER_REFERER=https://twa.thaiwater.net/

# Cloudflare R2 / S3-compatible Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=water-analysis-public
R2_PUBLIC_BASE_URL=https://data.example.com
R2_CUSTOM_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Local Storage Fallback Mode (useful when developing offline without R2 credentials)
# When set to true, files will be mirrored/saved to .r2-local/ directory
R2_LOCAL_FALLBACK=true

# LLM Hydrological Report Summarizer (OpenAI SDK & Function Calling)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
